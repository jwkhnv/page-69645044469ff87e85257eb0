ackground:#2d3a47;color:#fff;padding:9px 0;border-radius:5px;font-size:12px;font-weight:600;letter-spacing:1px;border-bottom:none}\n.plan-row.featured .select{background:#5fb7be;color:#0e2128}\n\n/* Steps */\n.steps{counter-reset:step}\n.step{display:grid;grid-template-columns:80px 1fr;gap:24px;padding:22px 0;border-bottom:1px solid #d4dadf}\n.step:last-child{border-bottom:none}\n.step .step-no{counter-increment:step;font-family:\"Georgia\",serif;font-size:34px;color:#266f7a;font-weight:700;line-height:1}\n.step .step-no::before{content:\"0\" counter(step)}\n.step h3{margin:0 0 6px;font-size:17px;color:#1c2733}\n.step p{margin:0;font-size:14px;color:#5a6772;line-height:1.7}\n\n/* Clients */\n.clients{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}\n.client-tile{background:#fff;border-radius:8px;padding:22px 18px;text-align:center;border:1px solid #d4dadf}\n.client-tile .icon{width:46px;height:46px;border-radius:10px;background:#e8f3f4;color:#266f7a;margin:0 auto 12px;display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:700;font-family:\"Georgia\",serif}\n.client-tile h4{margin:0 0 4px;font-size:14px;color:#1c2733}\n.client-tile p{margin:0;font-size:12px;color:#5a6772}\n\n/* FAQ — numbered list (faq_view: 2) */\n.faq-list{display:flex;flex-direction:column;gap:18px;counter-reset:faq}\n.faq-item{background:#fff;border-radius:10px;padding:26px 30px 26px 90px;position:relative}\n.faq-item::before{counter-increment:faq;content:\"Q\" counter(faq,decimal-leading-zero);position:absolute;left:26px;top:26px;font-family:\"Georgia\",serif;font-weight:700;font-size:26px;color:#5fb7be;background:#e8f3f4;padding:6px 10px;border-radius:5px;letter-spacing:-1px}\n.faq-item h3{margin:0 0 10px;font-size:16px;color:#1c2733;font-weight:700}\n.faq-item p{margin:0;color:#3c4a55;font-size:14px;line-height:1.75}\n\n/* Footer */\nfooter.foot{background:#1d2832;color:#9aa9b5;padding:48px 0 24px;font-size:13px}\nfooter .wrap{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:40px}\nfooter h4{color:#fff;font-size:13px;text-transform:uppercase;letter-spacing:2px;margin:0 0 16px}\nfooter ul{list-style:none;padding:0;margin:0}\nfooter li{margin-bottom:8px}\nfooter .copy{border-top:1px solid #2f3d49;margin-top:36px;padding-top:18px;text-align:center;font-size:12px;color:#6b7884}\n\n/* Responsive */\n@media (max-width:900px){.hero .wrap{grid-template-columns:1fr;gap:30px}\n.hero h1{font-size:38px}\n.section-head h2{font-size:24px}\n.num-cards{grid-template-columns:1fr}\n.plan-row{grid-template-columns:1fr;gap:18px;padding:24px}\n.plan-row .num{display:none}\n.clients{grid-template-columns:repeat(2,1fr)}\nfooter .wrap{grid-template-columns:1fr;gap:28px}\n.faq-item{padding-left:24px}\n.faq-item::before{position:relative;display:inline-block;left:0;top:0;margin-bottom:8px;font-size:16px}}\n</style><nav aria-label=\"面包屑与目录\" class=\"breadcrumb\">\n<div class=\"wrap\">\n<div class=\"crumbs\">\n<a href=\"#\">首页</a>\n<span class=\"sep\">›</span>\n<a href=\"#\">网络服务</a>\n<span class=\"sep\">›</span>\n<span class=\"crumb-current\">娃哈哈</span>\n</div>\n<div class=\"toc\" aria-label=\"页内目录\">\n<a href=\"#overview\">说明</a>\n<a href=\"#plans\">套餐</a>\n<a href=\"#steps\">使用步骤</a>\n<a href=\"#clients\">客户端</a>\n<a href=\"#faq\">问答</a>\n</div>\n</div>\n</nav>\n\n<main>\n\n<header class=\"hero\">\n<div class=\"wrap\">\n<div class=\"hero-text\">\n<div class=\"kicker\">网络连接服务 / 服务说明页</div>\n<h1>娃哈哈<br><span class=\"accent\">连接服务说明</span></h1>\n<p class=\"lede\">本页用问答的方式，把套餐内容、设备接入步骤与常见问题逐项说清楚。你可以按目录跳转到想了解的部分，也可以从头读到尾。</p>\n<div class=\"meta-row\">\n<div><span>服务版本</span><strong>v3.2</strong></div>\n<div><span>说明更新</span><strong>2025 年 8 月</strong></div>\n<div><span>文档章节</span><strong>6 节</strong></div>\n</div>\n<div class=\"actions\">\n<a class=\"btn btn-primary\" href=\"#plans\">查看套餐</a>\n<a class=\"btn btn-ghost\" href=\"#steps\">使用步骤</a>\n</div>\n</div>\n<aside class=\"info-panel\" aria-label=\"本页速览\">\n<h3>本页速览</h3>\n<dl>\n<dt>套餐档位</dt><dd>3 档可选</dd>\n<dt>设备数</dt><dd>3 至 20 台</dd>\n<dt>流量档</dt><dd>100 至 1000 GB / 月</dd>\n<dt>计费方式</dt><dd>按月或按年</dd>\n<dt>支持系统</dt><dd>查看客户端列表</dd>\n<dt>说明语言</dt><dd>简体中文</dd>\n</dl>\n<p class=\"note\">以下价格为页面示例，用于说明套餐档位之间的差异，实际购买请以你看到的后台或客户端内的结算页为准。</p>\n</aside>\n</div>\n</header>\n\n<section class=\"block\" id=\"overview\">\n<div class=\"wrap\">\n<div class=\"section-head\">\n<div>\n<div class=\"kicker\">关于本页</div>\n<h2>先弄清这三件事</h2>\n</div>\n<p>开始之前，简要理解娃哈哈提供的网络连接服务是什么、能做什么、以及不在什么范围内。</p>\n</div>\n<div class=\"num-cards\">\n<article class=\"num-card\">\n<span class=\"tag\">服务范围</span>\n<h3>连接服务说明</h3>\n<p>娃哈哈提供面向个人与团队的加密网络连接服务，主体包含节点路由、流量转发与设备接入三个环节，由用户根据套餐档位自行配置。</p>\n</article>\n<article class=\"num-card\">\n<span class=\"tag\">包含能力</span>\n<h3>套餐内权益</h3>\n<p>套餐费用覆盖节点访问、流量配额、设备数上限、工单响应速度；不同档位的差异主要体现在流量、设备数和附加能力上。</p>\n</article>\n<article class=\"num-card\">\n<span class=\"tag\">边界条件</span>\n<h3>不在范围内</h3>\n<p>套餐不包含终端硬件、域名注册、SSL 证书等周边产品；也不对链路抖动、断连恢复时长作出书面性能承诺。</p>\n</article>\n</div>\n</div>\n</section>\n\n<section class=\"block\" id=\"plans\">\n<div class=\"wrap\">\n<div class=\"section-head\">\n<div>\n<div class=\"kicker\">套餐说明</div>\n<h2>三档套餐，怎么选</h2>\n</div>\n<p>按行展开逐档阅读：左侧价格、中间功能、右侧按钮。选择时主要比较流量、设备数与附加能力。</p>\n</div>\n<div class=\"plans-list\">\n\n<article class=\"plan-row\">\n<div class=\"num\">01</div>\n<div>\n<h3 class=\"pname\">基础版</h3>\n<p class=\"pcopy\">面向个人或小流量场景，提供月度流量与基础接入能力。</p>\n</div>\n<ul class=\"feat-list\">\n<li>每月 100GB 流量额度</li>\n<li>支持 3 台设备同时在线</li>\n<li>解锁基础流媒体平台</li>\n<li>接入普通线路节点池</li>\n</ul>\n<div class=\"price-block\">\n<p class=\"price\">¥15<small> /月</small></p>\n<p class=\"annual\">按年付仅需 ¥150 / 年</p>\n<a class=\"select\" href=\"#\">选择此套餐</a>\n</div>\n</article>\n\n<article class=\"plan-row featured\">\n<div class=\"num\">02</div>\n<div>\n<h3 class=\"pname\">旗舰版 <span class=\"badge\">推荐</span></h3>\n<p class=\"pcopy\">适合同时使用多设备并对流媒体与游戏有较高要求的用户。</p>\n</div>\n<ul class=\"feat-list\">\n<li>每月 300GB 流量额度</li>\n<li>支持 5 台设备同时在线</li>\n<li>全节点原生流媒体解锁</li>\n<li>IPLC 专线游戏加速优化</li>\n<li>7×24 优先工单支持</li>\n</ul>\n<div class=\"price-block\">\n<p class=\"price\">¥35<small> /月</small></p>\n<p class=\"annual\">按年付仅需 ¥350 / 年</p>\n<a class=\"select\" href=\"#\">选择此套餐</a>\n</div>\n</article>\n\n<article class=\"plan-row\">\n<div class=\"num\">03</div>\n<div>\n<h3 class=\"pname\">团队版</h3>\n<p class=\"pcopy\">面向小型团队与多设备办公场景，提供较大流量与企业级附加项。</p>\n</div>\n<ul class=\"feat-list\">\n<li>每月 1000GB 流量额度</li>\n<li>支持 20 台设备同时在线</li>\n<li>VIP 专属高带宽节点</li>\n<li>支持企业定制路由策略</li>\n<li>专属客户经理服务</li>\n</ul>\n<div class=\"price-block\">\n<p class=\"price\">¥85<small> /月</small></p>\n<p class=\"annual\">按年付仅需 ¥850 / 年</p>\n<a class=\"select\" href=\"#\">选择此套餐</a>\n</div>\n</article>\n\n</div>\n</div>\n</section>\n\n<section class=\"block\" id=\"steps\">\n<div class=\"wrap\">\n<div class=\"section-head\">\n<div>\n<div class=\"kicker\">使用步骤</div>\n<h2>从账号到连接的五个步骤</h2>\n</div>\n<p>以下是典型用户接入娃哈哈服务的通用步骤，顺序可按你的实际工具灵活调整。</p>\n</div>\n<div class=\"steps\">\n\n<div class=\"step\">\n<div class=\"step-no\"></div>\n<div>\n<h3>注册账号并选择套餐</h3>\n<p>在用户中心使用邮箱注册账号，阅读三档套餐说明后选择适合的一档并完成支付。支付完成后账号权限将自动生效。</p>\n</div>\n</div>\n\n<div class=\"step\">\n<div class=\"step-no\"></div>\n<div>\n<h3>在后台查看订阅信息</h3>\n<p>登录后可在用户中心看到订阅状态、到期时间、流量剩余与设备接入密钥。请妥善保存密钥，避免泄露给他人。</p>\n</div>\n</div>\n\n<div class=\"step\">\n<div class=\"step-no\"></div>\n<div>\n<h3>下载对应的客户端</h3>\n<p>根据你的设备系统，从下方\"客户端\"区域选择 Windows、macOS、iOS、Android 或路由器固件对应的客户端，按指引安装。</p>\n</div>\n</div>\n\n<div class=\"step\">\n<div class=\"step-no\"></div>\n<div>\n<h3>导入订阅链接并连接</h3>\n<p>复制后台的订阅链接，粘贴到客户端的订阅栏中，点击更新并选择节点。首次连接建议选择延迟最低的节点进行测试。</p>\n</div>\n</div>\n\n<div class=\"step\">\n<div class=\"step-no\"></div>\n<div>\n<h3>验证与排错</h3>\n<p>通过浏览器访问常用站点验证连通性。如遇问题，先检查客户端版本、订阅更新时间，再通过工单或在线客服反馈。</p>\n</div>\n</div>\n\n</div>\n</div>\n</section>\n\n<section class=\"block\" id=\"clients\">\n<div class=\"wrap\">\n<div class=\"section-head\">\n<div>\n<div class=\"kicker\">客户端覆盖</div>\n<h2>常见设备的客户端支持</h2>\n</div>\n<p>下方列出常见设备类型对应的客户端名称与简要用途。具体下载与安装请以你登录后的客户端中心为准。</p>\n</div>\n<div class=\"clients\">\n<div class=\"client-tile\"><div class=\"icon\">W</div><h4>Windows</h4><p>桌面客户端</p></div>\n<div class=\"client-tile\"><div class=\"icon\">M</div><h4>macOS</h4><p>桌面客户端</p></div>\n<div class=\"client-tile\"><div class=\"icon\">i</div><h4>iOS</h4><p>移动客户端</p></div>\n<div class=\"client-tile\"><div class=\"icon\">A</div><h4>Android</h4><p>移动客户端</p></div>\n<div class=\"client-tile\"><div class=\"icon\">L</div><h4>Linux</h4><p>命令行工具</p></div>\n<div class=\"client-tile\"><div class=\"icon\">R</div><h4>路由器</h4><p>OpenWrt 固件</p></div>\n<div class=\"client-tile\"><div class=\"icon\">T</div><h4>电视端</h4><p>Android TV</p></div>\n<div class=\"client-tile\"><div class=\"icon\">U</div><h4>浏览器</h4><p>插件与扩展</p></div>\n</div>\n</div>\n</section>\n\n<section class=\"block\" id=\"faq\">\n<div class=\"wrap\">\n<div class=\"section-head\">\n<div>\n<div class=\"kicker\">常见问题</div>\n<h2>用户问得最多的六个问题</h2>\n</div>\n<p>按编号顺序阅读，每条问题后都附有直接答案。如果你的情况更复杂，请通过工单与人工客服联系。</p>\n</div>\n<div class=\"faq-list\">\n\n<article class=\"faq-item\">\n<h3>套餐之间最大的差别是什么？</h3>\n<p>差别主要集中在三个维度：每月可用的流量额度、可同时在线的设备数量，以及附加能力。基础版满足个人日常浏览；旗舰版增加了更多设备、更高流量和流媒体与游戏相关的优化；团队版面向多人多设备，并提供企业路由策略与专属客户经理。</p>\n</article>\n\n<article class=\"faq-item\">\n<h3>流量用完了会怎样？</h3>\n<p>当月流量耗尽后，本月剩余时间内连接将被暂停，账号与订阅仍然有效。次月 1 日配额自动恢复，不会清空账号；如需额外流量，可在用户中心购买流量包或升级到更高档位的套餐。</p>\n</article>\n\n<article class=\"faq-item\">\n<h3>一个账号能在多少台设备上使用？</h3>\n<p>数量取决于你选择的套餐：基础版 3 台，旗舰版 5 台，团队版 20 台。设备数量的判定按同时在线的客户端实例计算，重复登录同类型设备会按连接顺序保留最新的若干台。</p>\n</article>\n\n<article class=\"faq-item\">\n<h3>按月付和按年付可以切换吗？</h3>\n<p>可以切换。当你选择按年付时，本周期内不会自动续费次月；如果你在周期内希望切换到按月付，未使用的年付天数通常会按比例折算后抵扣下个月的月付账单，具体规则以用户中心的结算说明为准。</p>\n</article>\n\n<article class=\"faq-item\">\n<h3>遇到连接问题应该先排查哪里？</h3>\n<p>建议按顺序排查三件事：第一，客户端是否为最新版本，过低的客户端版本可能导致订阅无法解析；第二，订阅链接是否在 24 小时内更新过，过期的订阅地址需要手动同步；第三，所选节点是否健康，可在客户端中切换到延迟较低的节点测试。</p>\n</article>\n\n<article class=\"faq-item\">\n<h3>套餐可以多人合用吗？</h3>\n<p>从技术上讲，同一账号在同一时间最多支持的设备数就是套餐中标注的数量。如果你是多人共用，请评估总流量与设备数是否足够，避免因为同时在线人数过多触发套餐限制，或因为流量消耗超出预期导致停机。</p>\n</article>\n\n</div>\n</div>\n</section>\n\n</main>\n\n<footer class=\"foot\">\n<div class=\"wrap\">\n<div>\n<h4>娃哈哈</h4>\n<p>本页是娃哈哈网络连接服务的说明页面，所有内容仅用于介绍服务条款与套餐档位。</p>\n<p>本文档不构成对链路性能、流媒体兼容性与具体兼容设备的承诺，请以用户中心公示内容为准。</p>\n</div>\n<div>\n<h4>本页目录</h4>\n<ul>\n<li><a href=\"#overview\">关于本页</a></li>\n<li><a href=\"#plans\">套餐说明</a></li>\n<li><a href=\"#steps\">使用步骤</a></li>\n<li><a href=\"#clients\">客户端</a></li>\n<li><a href=\"#faq\">常见问题</a></li>\n</ul>\n</div>\n<div>\n<h4>联系说明</h4>\n<ul>\n<li>用户中心工单</li>\n<li>在线客服（工作时间）</li>\n<li>邮箱备案通道</li>\n</ul>\n</div>\n</div>\n<div class=\"copy\">© 娃哈哈 · 本说明文档作为服务条款的补充材料阅读</div>\n</footer>",
